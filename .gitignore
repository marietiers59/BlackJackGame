# ═══════════════════════════════════════════════════════════════
#  .gitignore universel — Marie Tiers
#  Adapté à : Windows 11 / Fedora / IDE JetBrains, VSCode, Eclipse
#  Stack : Java, Kotlin, C/C++, Python, PHP, JS/TS, Dart
# ═══════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────
#  SYSTÈMES D'EXPLOITATION
# ─────────────────────────────────────────────

# Linux (Fedora)
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Windows 11
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*


# ─────────────────────────────────────────────
#  IDE / ÉDITEURS
# ─────────────────────────────────────────────

# JetBrains (IntelliJ IDEA, PyCharm, PhpStorm)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/
cmake-build-*/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Eclipse
.metadata/
.classpath
.project
.settings/
.factorypath
.buildpath
.target
.tern-project
.springBeans
.recommenders/
.apt_generated/
bin/


# ─────────────────────────────────────────────
#  JAVA (21-25) & KOTLIN
# ─────────────────────────────────────────────

*.class
*.jar
*.war
*.ear
*.nar
*.ctxt
hs_err_pid*
replay_pid*

# Kotlin
*.kotlin_module

# JavaFX packaging
*.exe
*.dmg


# ─────────────────────────────────────────────
#  MAVEN
# ─────────────────────────────────────────────

target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
# Le wrapper Maven est utile à commit :
!.mvn/wrapper/
!mvnw
!mvnw.cmd


# ─────────────────────────────────────────────
#  GRADLE
# ─────────────────────────────────────────────

.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat


# ─────────────────────────────────────────────
#  TESTS JAVA (JUnit, Mockito)
# ─────────────────────────────────────────────

# JUnit et Mockito n'ont pas de fichiers spécifiques à ignorer
# au-delà de ce que couvrent déjà Maven/Gradle (target/, build/).
# Rapports de couverture éventuels :
jacoco.exec
*.jacoco
coverage/
test-results/
test-output/


# ─────────────────────────────────────────────
#  C / C++
# ─────────────────────────────────────────────

# Compilés
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug
*.dSYM/
*.su
*.idb
*.pdb

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/


# ─────────────────────────────────────────────
#  PYTHON (Flask, Django, Data Science)
# ─────────────────────────────────────────────

__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environnements virtuels
.venv/
venv/
env/
ENV/
.python-version

# Tests et qualité
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pylint.d/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Packaging
*.egg
*.egg-info/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-log.txt
pip-delete-this-directory.txt

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Flask
instance/
.webassets-cache

# Jupyter / IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Data science : sorties de matplotlib/seaborn si générées en masse
# (à décommenter si tu ne veux PAS versionner tes figures)
# *.png
# *.jpg
# *.pdf

# Datasets lourds (adapte selon ton projet)
*.csv.gz
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
data/raw/
data/interim/
# ⚠️ Ne PAS ignorer data/ en entier si tu veux versionner
# les fixtures ou les petits jeux de démo


# ─────────────────────────────────────────────
#  PHP 8 (Laravel, Symfony, PHPUnit)
# ─────────────────────────────────────────────

# Composer
/vendor/
composer.phar

# PHPUnit
.phpunit.result.cache
.phpunit.cache/
phpunit.xml

# Laravel
/public/hot
/public/storage
/storage/*.key
/storage/app/public/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/testing/
/storage/framework/views/
/storage/logs/
/bootstrap/cache/
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

# Symfony
/var/
!/var/.gitkeep
/config/secrets/prod/prod.decrypt.private.php
.php-cs-fixer.cache
.php_cs.cache


# ─────────────────────────────────────────────
#  JAVASCRIPT / TYPESCRIPT (Node, Vue, React)
# ─────────────────────────────────────────────

# Dépendances
node_modules/
jspm_packages/
bower_components/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Builds
dist/
build/
out/
.next/
.nuxt/
.vite/
.parcel-cache/
.turbo/
.svelte-kit/

# TypeScript
*.tsbuildinfo
.tscache/

# Logs npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tests JS
coverage/
.nyc_output/


# ─────────────────────────────────────────────
#  HTML / CSS
# ─────────────────────────────────────────────

# CSS générés par des préprocesseurs (Sass, Less)
# Si tu écris directement en CSS, commente ces lignes.
*.css.map
*.min.css
*.min.js

# Sass
.sass-cache/


# ─────────────────────────────────────────────
#  E2E ET API TESTING (Playwright, Bruno, Postman)
# ─────────────────────────────────────────────

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# Bruno et Postman : les collections DOIVENT être commit
# (c'est du code de test !). Ce qui NE doit pas l'être :
# les environnements locaux avec secrets.
.env.bruno
*-environment.local.json
postman_environment.local.json


# ─────────────────────────────────────────────
#  FLUTTER / DART
# ─────────────────────────────────────────────

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
flutter_export_environment.sh

# Android/iOS générés par Flutter
/android/app/debug
/android/app/profile
/android/app/release
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Runner.xcworkspace/xcuserdata/


# ─────────────────────────────────────────────
#  DOCKER / PODMAN
# ─────────────────────────────────────────────

# Le Dockerfile et docker-compose.yml DOIVENT être commit.
# Ce qui NE doit pas l'être :
.docker/
docker-compose.override.yml
*.env.docker

# Volumes de données locaux
docker-data/
podman-data/


# ─────────────────────────────────────────────
#  KUBERNETES
# ─────────────────────────────────────────────

# Les manifests YAML DOIVENT être commit.
# Ce qui NE doit pas l'être :
kubeconfig
*.kubeconfig
.kube/
kustomization.local.yaml

# Helm
charts/*.tgz
.helm/


# ─────────────────────────────────────────────
#  BASES DE DONNÉES
# ─────────────────────────────────────────────

# PostgreSQL
*.sql.bak
*.dump
*.backup
*.pgdump
*.sql.gz
*.sql.tar
pg_log/
pgdata/
postgres-data/
pgpass.conf
.pgpass

# MySQL / MariaDB
*.mysql.dump
mysql-data/
mariadb-data/
my.cnf.local

# SQLite
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
# ⚠️ Si tu utilises une DB SQLite comme fixture de test versionnée,
# décommente cette ligne pour la garder :
# !fixtures/test.sqlite

# MongoDB
mongo-data/
dump/
*.bson

# NoSQL divers
*.rdb        # Redis
*.aof        # Redis append-only file


# ─────────────────────────────────────────────
#  DONNÉES ET FICHIERS GÉNÉRÉS
# ─────────────────────────────────────────────

# JSON de config locale (mais pas package.json, composer.json, etc.)
config.local.json
*.local.json
settings.local.json


# ─────────────────────────────────────────────
#  SECRETS — ⚠️ NE JAMAIS COMMIT
# ─────────────────────────────────────────────

.env
.env.*
!.env.example
!.env.dist
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.json
secrets.yaml
credentials.json
credentials.yaml
service-account*.json


# ─────────────────────────────────────────────
#  LOGS ET TEMPORAIRES
# ─────────────────────────────────────────────

*.log
logs/
*.tmp
*.temp
*.old
*.orig
*.swp
*.swo
*~
